# 4. Vercel va Frontend CORS Sozlamalari
# Vercel domenini kiriting (vergul bilan bir nechta yozish mumkin):
# CORS_ORIGINS=https://xodim-reyting.vercel.app,https://mycrm.com
CORS_ORIGINS=*

# 5. Server va Port
PORT=8000
HOST=0.0.0.0
DEBUG=False
