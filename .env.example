# 1. Telegram Bot Sozlamalari
BOT_TOKEN=8932019841:AAFCkLdoBhzmkGJy3L0MY4-esw0_aToQiZY
TELEGRAM_GROUP_ID=-1005381348358
RAHBAR_ID=8686341550

# 2. Xavfsizlik va JWT Token
JWT_SECRET=super_secret_jwt_key_xodim_reyting_2026_change_in_production
JWT_EXPIRATION_MINUTES=1440
OTP_EXPIRATION_SECONDS=60

# 3. Ma'lumotlar Bazasi (Bulutli Supabase / Managed PostgreSQL)
# Agar ushbu qator bo'sh qoldirilsa, tizim lokal SQLite (xodim_reyting.db) dan foydalanadi
# Supabase yoki Railway PostgreSQL uchun:
# DATABASE_URL=postgresql://postgres.projectid:password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
